{
  "name": "@samislam/react-datatable",
  "version": "0.0.0",
  "description": "Headless, server-driven, virtualized data table on TanStack Table + react-virtual.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.9"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
