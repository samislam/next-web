# Every variable here is OPTIONAL — the app boots with no .env file at all, using the development
# defaults in src/server/{server,client}-env.ts. Copy this file to .env.development and edit only
# what you need to change.

# Server configuration
PORT=3000                          # default: 3000
APP_ORIGIN=""                      # default: http://localhost:$PORT

ENABLE_REDIS_CACHE=true            # default: true (fails open when REDIS_URL is unset)
# REDIS_URL=""                     # e.g. redis://:password@127.0.0.1:6379
ENABLE_FALLBACK_CACHE=true         # default: true — in-process memory cache
NEXT_PUBLIC_ENVIRONMENT="localhost"  # production | staging | testing | localhost
IMAGE_OPTIMIZATION="yes"           # yes | no
REQUIRE_HTTPS=true                 # default: true in production, false elsewhere

# DATABASE (PostgreSQL) — only if this app talks to a database directly
ENABLE_DATABASE="no"               # yes | no
# DATABASE_URL=""

# EXTERNAL BACKEND — optional, and there is no default.
# This app is standalone full-stack: the Elysia routes under src/app/api/[[...slugs]]/ are a complete
# backend. Set this only if the project ALSO (or instead) talks to a separate API; the code paths that
# need it read it through mainApiBaseUrl() and say so if it is missing.
# NEXT_PUBLIC_MAIN_API_BASE_URL="http://localhost:4000/api/v1"

# SDK generation / OpenAPI / Nestia .. etc
# ORVAL_OPENAPI_URL="http://localhost:4000/api-json"

# Localization — get these from https://app.tolgee.io/
# NEXT_PUBLIC_TOLGEE_API_KEY=""
# NEXT_PUBLIC_TOLGEE_API_URL=""
# NEXT_PUBLIC_TOLGEE_PROJECT_ID=""

# SENTRY (error logging)
ENABLE_SENTRY="no"                 # yes | no
# SENTRY_ORG="example"
# SENTRY_PROJECT="example"
# SENTRY_AUTH_TOKEN="example"
# NEXT_PUBLIC_SENTRY_DSN="https://CHANGE_ME.com"
